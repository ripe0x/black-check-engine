# Copy to a runtime secret store; DO NOT commit a filled-in copy. Values here are empty on purpose.
RPC_URL=https://mainnet.gateway.tenderly.co
ENGINE=
HOOK=
BURNER=
DRY_RUN=true
# Only for real sends (DRY_RUN=false). Pass as a runtime secret; never write a value into this file or any file.
KEEPER_PRIVATE_KEY=
# Scan engine events from the deploy block on mainnet to keep the log scan cheap.
FROM_BLOCK=0
CHUNK_BLOCKS=5000
FWA_BATCH=20
MAX_GAS_PRICE_GWEI=0
POLL_SECONDS=60
CHAIN_ID=1
