# Values only. No keys here: the deploying wallet signs through `--account`/`--ledger` (see docs/DEPLOY.md).
RPC_URL=https://mainnet.gateway.tenderly.co
DEPLOY_ENV=mainnet
OWNER=0xCB43078C32423F5348Cab5885911C3B5faE217F9   # ripe0x.eth: the administrator and Draw Packs admin (transferable, renounceable)
COLLECTION=bayc
COIN_NAME="ApeBall"                                # identity (D69); independent of Yuga/BAYC; re-check conflicts on the day
COIN_SYMBOL=APEBALL
COIN_IMAGE=""                                      # OWNER: the coin's image URL in its contract URI (empty allowed; updateImage later, D86)
COIN_DESCRIPTION=""                                # OWNER: the coin's description (empty allowed; updateMetadata later, D86)
REF_PRICE_WEI=6000000000000000000                  # OWNER: the live BAYC floor on the day (the live bid's first activation threshold is 100% of it, D64)
MAX_PRICE_WEI=0                                    # optional emergency cap on any acquisition (0: none)
