# Single config surface: contract addresses, chain and RPC. No secrets. Copy to .env.local and fill in after a
# deployment. Next inlines NEXT_PUBLIC_* at build time (this is a static export). Reads default to the Tenderly public
# mainnet gateway. The site shows a "not deployed / test build" banner until ENGINE is a real address.
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_RPC_URL=https://mainnet.gateway.tenderly.co
NEXT_PUBLIC_ENGINE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_PROJECT_NAME=Survival Checks (placeholder)
NEXT_PUBLIC_COIN_SYMBOL=COIN
